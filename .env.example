# Copy to .env.local and fill in from the Supabase dashboard:
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required only by "describe a meal". Without it that screen says so and
# every other logging path keeps working.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-haiku-4-5.
ANTHROPIC_MODEL=
